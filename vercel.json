{
  "trailingSlash": false,
  "functions": {
    "api/product-page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/not-found.js": {
      "includeFiles": "dist/index.html"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/product/:path*",
      "destination": "/api/product-page?path=:path*"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/collections",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/placeOrder",
      "destination": "/index.html"
    },
    {
      "source": "/orders",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/change-password",
      "destination": "/index.html"
    },
    {
      "source": "/track/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/api/not-found?path=:path*"
    }
  ]
}